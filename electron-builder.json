{
  "appId": "com.fcpos.desktop",
  "productName": "FCPos Desktop",
  "electronVersion": "33.0.0",
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "directories": {
    "output": "electron-dist"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/icon.png",
    "uninstallerIcon": "assets/icon.png",
    "installerHeaderIcon": "assets/icon.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/icon.png"
  }
}
