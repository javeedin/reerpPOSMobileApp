{
  "expo": {
    "name": "FCPos",
    "slug": "reerp-pos-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fcpos.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.fcpos.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FCPos to access your camera for scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FCPos to access your photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FCPos to access your photos.",
          "savePhotosPermission": "Allow FCPos to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
