{
  "name": "reerp-pos-mobile-app",
  "version": "1.1.7",
  "description": "FCPos Desktop - Point of Sale Application",
  "author": "Grays Inc",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "electron:dev": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && cross-env NODE_ENV=development electron electron/main.js\"",
    "electron:build": "npm run build:web && electron-builder --config electron-builder.json",
    "electron:build:win": "npm run build:web && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.6.2",
    "expo": "~54.0.0",
    "expo-application": "^7.0.8",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "^19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "^13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "^55.0.9",
    "expo-print": "^15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.12.5",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.9",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^9.0.3"
  },
  "private": true
}
